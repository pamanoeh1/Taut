<IfModule mod_rewrite.c>
  RewriteEngine On

  # Pass Authorization header to PHP (critical on InfinityFree / Apache CGI)
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Protect internal JSON data directory from direct web access
  RewriteRule ^api/data/ - [F,L]

  # Route all API requests & explicit /s/:slug redirects to PHP InfinityFree backend
  RewriteRule ^api(/.*)?$ api/index.php [QSA,L]
  RewriteRule ^s/([^/]+)/?$ api/index.php?__route=/s/$1 [QSA,L]

  # Serve existing static files (assets, favicon, etc.) directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route custom-domain root shortlink slugs (/:slug) directly via PHP redirect engine without login
  RewriteCond %{REQUEST_URI} !^/(api|s|u|assets|admin|login|logout|dashboard|analytics|bio|settings|health)(/|$) [NC]
  RewriteRule ^([a-zA-Z0-9_-]{3,64})/?$ api/index.php?__route=/s/$1 [QSA,L]

  # Route React SPA views (/u/handle, /, etc.) to index.html
  RewriteRule ^ index.html [L]
</IfModule>
